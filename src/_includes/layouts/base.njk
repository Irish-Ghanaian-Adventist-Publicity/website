<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{% if title %}{{ title }} — {{ site.name }}{% else %}{{ site.name }} — {{ site.tagline }}{% endif %}</title>
    <meta name="description" content="{{ description or subtitle or site.description }}" />
    <meta property="og:title" content="{% if title %}{{ title }} — {{ site.name }}{% else %}{{ site.name }}{% endif %}" />
    <meta property="og:description" content="{{ description or subtitle or site.description }}" />
    <meta property="og:type" content="website" />
    {% if image %}<meta property="og:image" content="{{ image | url }}" />{% endif %}
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="{{ '/assets/img/favicon.svg' | url }}" type="image/svg+xml" />
    <link rel="stylesheet" href="{{ '/assets/css/style.css' | url }}" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    {% include "partials/header.njk" %}

    <main id="main">{{ content | safe }}</main>

    {% include "partials/footer.njk" %}

    <script src="{{ '/assets/js/main.js' | url }}" defer></script>
  </body>
</html>
