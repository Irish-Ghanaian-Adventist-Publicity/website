{% if site.notice %}
  <div class="notice-bar">
    <div class="wrap">
      {% if site.notice_url %}
        <a href="{{ site.notice_url | url }}">{{ site.notice }}</a>
      {% else %}
        <span>{{ site.notice }}</span>
      {% endif %}
    </div>
  </div>
{% endif %}

<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="logo" href="{{ '/' | url }}">
      <span class="logo__mark">{{ site.short_name }}</span>
      <span class="logo__text">
        <strong>{{ site.name }}</strong>
      </span>
    </a>

    <button
      class="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="primary-nav"
    >
      <span class="nav-toggle__bars" aria-hidden="true"></span>
      <span class="visually-hidden">Menu</span>
    </button>

    <nav class="nav" id="primary-nav" aria-label="Main">
      <ul>
        {% for item in site.nav %}
          <li>
            <a
              href="{{ item.url | url }}"
              {% if page.url == item.url %}aria-current="page"{% endif %}
            >{{ item.label }}</a>
          </li>
        {% endfor %}
        <li class="nav__cta">
          <a class="btn btn--sm" href="{{ '/join/' | url }}">Get involved</a>
        </li>
      </ul>
    </nav>
  </div>
</header>
