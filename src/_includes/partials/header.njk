{% if site.notice %}
  <div class="notice-bar">
    <div class="wrap">
      <span class="notice-bar__star" aria-hidden="true">★</span>
      {% if site.notice_url %}
        <a href="{{ site.notice_url | url }}">{{ site.notice }}</a>
      {% else %}
        <span>{{ site.notice }}</span>
      {% endif %}
    </div>
  </div>
{% endif %}

<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="logo" href="{{ '/' | url }}">
      <span class="logo__mark" aria-hidden="true">
        <svg viewBox="0 0 40 40" width="40" height="40">
          <rect width="40" height="13.33" fill="#CE1126" />
          <rect y="13.33" width="40" height="13.33" fill="#FCD116" />
          <rect y="26.66" width="40" height="13.34" fill="#006B3F" />
          <path
            fill="#000"
            d="M20 14.6l1.72 5.3h5.57l-4.5 3.27 1.72 5.3L20 25.2l-4.51 3.27 1.72-5.3-4.5-3.27h5.57z"
          />
        </svg>
      </span>
      <span class="logo__text">
        <strong>{{ site.short_name }}</strong>
        <small>{{ site.name }}</small>
      </span>
    </a>

    <button
      class="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="primary-nav"
    >
      <span class="nav-toggle__bars" aria-hidden="true"></span>
      <span class="visually-hidden">Menu</span>
    </button>

    <nav class="nav" id="primary-nav" aria-label="Main">
      <ul>
        {% for item in site.nav %}
          <li>
            <a
              href="{{ item.url | url }}"
              {% if page.url == item.url %}aria-current="page"{% endif %}
            >{{ item.label }}</a>
          </li>
        {% endfor %}
        <li class="nav__cta">
          <a class="btn btn--sm" href="{{ '/worship/' | url }}">Visit us</a>
        </li>
      </ul>
    </nav>
  </div>
</header>
