<footer class="site-footer">
  <div class="wrap site-footer__grid">
    <div class="site-footer__brand">
      <p class="site-footer__name">{{ site.name }}</p>
      <p class="site-footer__tagline">{{ site.tagline }}</p>
      <p class="kente-rule" aria-hidden="true"></p>
    </div>

    <div>
      <h2 class="site-footer__heading">Explore</h2>
      <ul class="site-footer__links">
        {% for item in site.nav %}
          <li><a href="{{ item.url | url }}">{{ item.label }}</a></li>
        {% endfor %}
        <li><a href="{{ '/join/' | url }}">Get involved</a></li>
      </ul>
    </div>

    <div>
      <h2 class="site-footer__heading">Get in touch</h2>
      <ul class="site-footer__links">
        <li><a href="mailto:{{ site.email }}">{{ site.email }}</a></li>
        {% if site.phone %}<li><a href="tel:{{ site.phone | replace(" ", "") }}">{{ site.phone }}</a></li>{% endif %}
      </ul>

      <ul class="social">
        {% if site.social.facebook %}<li><a href="{{ site.social.facebook }}" rel="noopener">Facebook</a></li>{% endif %}
        {% if site.social.instagram %}<li><a href="{{ site.social.instagram }}" rel="noopener">Instagram</a></li>{% endif %}
        {% if site.social.whatsapp %}<li><a href="{{ site.social.whatsapp }}" rel="noopener">WhatsApp</a></li>{% endif %}
        {% if site.social.youtube %}<li><a href="{{ site.social.youtube }}" rel="noopener">YouTube</a></li>{% endif %}
        {% if site.social.x %}<li><a href="{{ site.social.x }}" rel="noopener">X</a></li>{% endif %}
      </ul>
    </div>
  </div>

  <div class="wrap site-footer__base">
    <p>&copy; {{ "" | year }} {{ site.name }}. Made with love in Accra and on the island of Ireland.</p>
    <p><a href="{{ '/admin/' | url }}">Committee login</a></p>
  </div>
</footer>
