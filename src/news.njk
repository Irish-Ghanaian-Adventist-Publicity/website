---
layout: layouts/base.njk
title: News & Notices
subtitle: Announcements and updates from the committee.
permalink: /news/
eleventyExcludeFromCollections: true
---

<div class="page-hero">
  <div class="wrap">
    <span class="eyebrow">Notices</span>
    <h1>{{ title }}</h1>
    <p class="page-hero__sub">{{ subtitle }}</p>
  </div>
</div>

<div class="wrap">
  <section class="section section--flush">
    {% if collections.newsPosts.length %}
      <div class="cards cards--3">
        {% for post in collections.newsPosts %}
          <a class="card{% if post.data.pinned %} card--pinned{% endif %}" href="{{ post.url | url }}">
            {% if post.data.pinned %}<span class="pin">Pinned</span>{% endif %}
            <time class="card__date" datetime="{{ post.data.date | isoDate }}">{{ post.data.date | longDate }}</time>
            <h2>{{ post.data.title }}</h2>
            <p>{{ post.data.summary or (post.templateContent | excerpt(150)) }}</p>
            {% if post.data.author %}<p class="card__meta">{{ post.data.author }}</p>{% endif %}
          </a>
        {% endfor %}
      </div>
    {% else %}
      <div class="empty"><p>No news posted yet — check back soon.</p></div>
    {% endif %}
  </section>
</div>
