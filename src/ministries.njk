---
layout: layouts/base.njk
title: What we do
subtitle: The strands of community life that keep going between gatherings — and where you might fit.
permalink: /ministries/
eleventyExcludeFromCollections: true
---

<div class="page-hero">
  <div class="wrap">
    <span class="eyebrow">Community life</span>
    <h1>{{ title }}</h1>
    <p class="page-hero__sub">{{ subtitle }}</p>
  </div>
</div>

<div class="wrap">
  <section class="section section--flush">
    {% set ministries = collections.ministries | sort(false, false, "data.order") %}
    {% if ministries.length %}
      <div class="cards cards--3">
        {% for ministry in ministries %}
          <a class="card" href="{{ ministry.url | url }}">
            <span class="card__icon" aria-hidden="true">
              {% set icon = ministry.data.icon %}{% include "partials/icon.njk" %}
            </span>
            <h2>{{ ministry.data.title }}</h2>
            <p>{{ ministry.data.summary }}</p>
            {% if ministry.data.meets %}<span class="tag">{{ ministry.data.meets }}</span>{% endif %}
          </a>
        {% endfor %}
      </div>
    {% else %}
      <div class="empty"><p>Pages are being added — check back soon.</p></div>
    {% endif %}
  </section>

  <section class="section section--flush">
    <div class="callout">
      <h2>Nothing here belongs to any one person</h2>
      <p>
        If you can sing or play, teach, drive, cook, take photographs, run a sound desk, sit
        with someone who is unwell, or simply turn up early and set out chairs — there is a
        place for you. Email <a href="mailto:{{ site.email }}">{{ site.email }}</a>.
      </p>
    </div>
  </section>
</div>
