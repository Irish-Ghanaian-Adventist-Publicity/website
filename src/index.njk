---
layout: layouts/base.njk
permalink: /
eleventyExcludeFromCollections: true
---

<section class="hero">
  <div class="wrap hero__inner">
    <p class="hero__eyebrow">{{ home.hero_eyebrow }}</p>
    <h1 class="hero__title">{{ home.hero_title }}</h1>
    <p class="hero__text">{{ home.hero_text }}</p>
    <p class="hero__actions">
      <a class="btn" href="{{ home.primary_cta_url | url }}">{{ home.primary_cta_label }}</a>
      {% if home.secondary_cta_label %}
        <a class="btn btn--ghost" href="{{ home.secondary_cta_url | url }}">{{ home.secondary_cta_label }}</a>
      {% endif %}
    </p>
  </div>
</section>

{% if home.hero_image %}
  <figure class="photo-band">
    <img
      src="{{ home.hero_image | url }}"
      alt="{{ home.hero_image_alt or 'Members of the Irish-Ghanaian Adventist Community gathered together' }}"
      width="2000"
      height="653"
    />
    {% if home.hero_image_caption %}
      <figcaption class="wrap">{{ home.hero_image_caption }}</figcaption>
    {% endif %}
  </figure>
{% endif %}

{% if home.stats.length %}
  <section class="facts">
    <div class="wrap facts__grid">
      {% for stat in home.stats %}
        <div class="fact">
          <span class="fact__value">{{ stat.value }}</span>
          <span class="fact__label">{{ stat.label }}</span>
        </div>
      {% endfor %}
    </div>
  </section>
{% endif %}

<section class="section">
  <div class="wrap">
    <header class="section__head">
      <span class="eyebrow">What we are about</span>
      <h2>Worship, connection and care</h2>
      <p>Three things we try to do well, for everyone who calls this island home.</p>
    </header>

    <div class="cards cards--3">
      {% for pillar in home.pillars %}
        <article class="card">
          <span class="card__icon" aria-hidden="true">{% include "partials/icon.njk" %}</span>
          <h3>{{ pillar.title }}</h3>
          <p>{{ pillar.text }}</p>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% set upcoming = collections.upcomingEvents | limit(3) %}
<section class="section section--tint">
  <div class="wrap">
    <header class="section__head section__head--row">
      <div>
        <span class="eyebrow">Diary</span>
        <h2>Coming up</h2>
        <p>We gather several times a year, in different parts of the island. Everyone is welcome.</p>
      </div>
      <a class="link-arrow" href="{{ '/events/' | url }}">All gatherings</a>
    </header>

    {% if upcoming.length %}
      <div class="cards cards--3">
        {% for event in upcoming %}
          {% include "partials/event-card.njk" %}
        {% endfor %}
      </div>
    {% else %}
      <div class="empty">
        <p>Nothing in the diary just now — the next gathering will be announced here.</p>
      </div>
    {% endif %}
  </div>
</section>

{% if home.quote %}
  <section class="quote-band">
    <div class="wrap wrap--narrow">
      <blockquote>
        <p>{{ home.quote }}</p>
        {% if home.quote_author %}<cite>{{ home.quote_author }}</cite>{% endif %}
      </blockquote>
    </div>
  </section>
{% endif %}

<section class="section">
  <div class="wrap">
    <header class="section__head section__head--row">
      <div>
        <span class="eyebrow">Practical help</span>
        <h2>New to Ireland?</h2>
        <p>Straight answers to the questions almost everyone has in their first year here.</p>
      </div>
      <a class="link-arrow" href="{{ '/support/' | url }}">All guides</a>
    </header>

    <div class="cards cards--3">
      {% for guide in collections.resources | limit(3) %}
        <a class="card" href="{{ guide.url | url }}">
          <h3>{{ guide.data.title }}</h3>
          <p>{{ guide.data.summary }}</p>
          <span class="tag">{{ guide.data.jurisdiction }}</span>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

{% set latest = collections.newsPosts | limit(3) %}
{% if latest.length %}
  <section class="section section--tint">
    <div class="wrap">
      <header class="section__head section__head--row">
        <div>
          <span class="eyebrow">Notices</span>
          <h2>Latest news</h2>
        </div>
        <a class="link-arrow" href="{{ '/news/' | url }}">All news</a>
      </header>

      <div class="cards cards--3">
        {% for post in latest %}
          <a class="card" href="{{ post.url | url }}">
            <time class="card__date" datetime="{{ post.data.date | isoDate }}">{{ post.data.date | longDate }}</time>
            <h3>{{ post.data.title }}</h3>
            <p>{{ post.data.summary or (post.templateContent | excerpt(130)) }}</p>
          </a>
        {% endfor %}
      </div>
    </div>
  </section>
{% endif %}

<section class="cta-band">
  <div class="wrap wrap--narrow">
    <h2>There is always room for one more</h2>
    <p>
      Come to a gathering, or simply let us know you're out there. No commitment,
      nothing to sign.
    </p>
    <a class="btn" href="{{ '/join/' | url }}">Get involved</a>
  </div>
</section>
