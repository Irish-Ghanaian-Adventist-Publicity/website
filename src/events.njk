---
layout: layouts/base.njk
title: Gatherings
subtitle: We come together several times a year, in different parts of the island. Everyone is welcome — members, friends and anyone simply curious.
permalink: /events/
eleventyExcludeFromCollections: true
---

<div class="page-hero">
  <div class="wrap">
    <span class="eyebrow">Diary</span>
    <h1>{{ title }}</h1>
    <p class="page-hero__sub">{{ subtitle }}</p>
  </div>
</div>

<div class="wrap">
  <section class="section section--flush">
    <h2 class="section__title">Coming up</h2>
    {% if collections.upcomingEvents.length %}
      <div class="cards cards--3">
        {% for event in collections.upcomingEvents %}
          {% include "partials/event-card.njk" %}
        {% endfor %}
      </div>
    {% else %}
      <div class="empty">
        <p><strong>Nothing in the diary just now.</strong></p>
        <p>
          The next gathering will be announced here and by email.
          <a href="{{ '/join/' | url }}">Let us know you're out there</a> and we'll tell you directly.
        </p>
      </div>
    {% endif %}
  </section>

  {% if collections.pastEvents.length %}
    <section class="section section--flush">
      <h2 class="section__title">Previously</h2>
      <ul class="past-list">
        {% for event in collections.pastEvents | limit(12) %}
          <li>
            <a href="{{ event.url | url }}">
              <time datetime="{{ event.data.event_date | isoDate }}">{{ event.data.event_date | longDate }}</time>
              <span>{{ event.data.title }}</span>
              {% if event.data.city %}<em>{{ event.data.city }}</em>{% endif %}
            </a>
          </li>
        {% endfor %}
      </ul>
    </section>
  {% endif %}
</div>
